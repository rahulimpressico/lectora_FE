# Local dev uses Vite proxy at /api — leave unset or use:
# VITE_API_BASE_URL=/api
#
# Start the dev backend (no Entra auth required):
#   cd ../../lectora-course-gen-engine
#   source .venv/bin/activate
#   uvicorn lectora_backend.dev_app:app --reload --port 8000

# Production / Netlify (direct backend, no Netlify /api proxy):
# VITE_API_BASE_URL=https://lectora-course-gen-engine.onrender.com
#
# Legacy Render backend:
# VITE_API_BASE_URL=https://lectora-be.onrender.com
#
# Dev: proxy /api to Render instead of localhost:8000:
# VITE_API_PROXY_TARGET=https://lectora-course-gen-engine.onrender.com
