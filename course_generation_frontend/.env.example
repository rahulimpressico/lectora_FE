# Local dev uses Vite proxy at /api — leave unset or use:
# VITE_API_BASE_URL=/api
#
# Start the dev backend (lectora_BE_refine — Entra ID Bearer auth required):
#   cd ../../lectora_BE_refine
#   source .venv/bin/activate
#   uvicorn app.main:app --reload --port 8000

# Microsoft Entra ID (MSAL) — required for frontend sign-in when enabled
# VITE_AZURE_TENANT_ID=your-tenant-id
# VITE_AZURE_CLIENT_ID=your-spa-client-id
# VITE_AZURE_REDIRECT_URI=http://localhost:5173
# Comma-separated identity/consent scopes (e.g. openid,email,profile,User.Read)
# VITE_AZURE_SCOPES=openid,email,profile,User.Read
# Backend API scope for access tokens (e.g. api://app-id/access_as_user)
# VITE_AZURE_API_SCOPE=

# Production / Netlify — required, no hardcoded fallback (see src/config/api.ts):
# VITE_API_BASE_URL=https://<your-lectora-be-refine-deployment>

# Dev: proxy /api to a remote lectora_BE_refine instead of localhost:8000:
# VITE_API_PROXY_TARGET=https://<your-lectora-be-refine-deployment>
